  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash -e
#set -eux
#set -eu

CONTAINER_NAME=&quot;${PROJECT_NAME}_build&quot;
DOCKER_COMMAND=&quot; -e TZ=Asia/Taipei --rm -dit -v ${HOST_SRC_PATH}:/app/src --name ${CONTAINER_NAME}&quot;

cleanup() {
# stop 後如果容器是 --rm 建立的 → 容器就會被自動刪除
    if docker container inspect &quot;${CONTAINER_NAME}&quot; &gt;/dev/null 2&gt;&amp;1; then
        docker stop &quot;${CONTAINER_NAME}&quot;
        echo &quot;The container was deleted: ${CONTAINER_NAME}&quot;
    fi
}
trap cleanup EXIT

docker container rm -f ${CONTAINER_NAME} || true
docker container run ${DOCKER_COMMAND} ${LINUXC_IMAGE_NAME} bash
#docker container exec -i ${CONTAINER_NAME} bash -c &quot;ls /app/src&quot;
# Build project
docker container exec -i ${CONTAINER_NAME} bash -c &quot;cd /app/src/${PROJECT_NAME} &amp;&amp; make deep_build&quot;
# docker container exec -i ${CONTAINER_NAME} bash -c &quot;ls /app/bin&quot;

# According to the Jenkins log: Building in workspace /var/jenkins_home/workspace/finance_cluster_build
echo &quot;Jenkins Workspace: $WORKSPACE&quot;
# Make artifact
rm -rf &quot;$WORKSPACE/artifacts&quot;  # in Jenkins space
mkdir -p &quot;$WORKSPACE/artifacts&quot;
# Copy build results from build container to Jenkins workspace
docker cp ${CONTAINER_NAME}:/app/bin/. &quot;$WORKSPACE/artifacts/&quot;

</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
