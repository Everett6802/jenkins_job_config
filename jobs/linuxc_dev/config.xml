  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash -e
#set -eux
#set -eu

LOCAL=Asia/Taipei
DOCKER_COMMAND=&quot; -e TZ=${LOCAL} --rm -dit -v ${HOST_SRC_PATH}:/app/src --name ${CONTAINER_NAME}&quot;
# 加上雙引號 &quot; 可以避免空字串導致語法錯誤
if [ &quot;${ENABLE_PORT}&quot; = &quot;true&quot; ]
then
   DOCKER_COMMAND=&quot;${DOCKER_COMMAND} -p ${HOST_PORT}:${CONTAINER_PORT}&quot;
fi
if [ &quot;${ENABLE_COREDUMP}&quot; = &quot;true&quot; ]
then
   DOCKER_COMMAND=&quot;${DOCKER_COMMAND} --privileged&quot;
fi
if [ &quot;${NEED_NETWORK}&quot; = &quot;true&quot; ]
then
   DOCKER_COMMAND=&quot;${DOCKER_COMMAND} --network ${NETWORK_NAME}&quot; 
fi

docker container rm -f ${CONTAINER_NAME} 2&gt; /dev/null || true
docker container run ${DOCKER_COMMAND} ${LINUXC_IMAGE_NAME} bash
if [ &quot;${ENABLE_COREDUMP}&quot; = &quot;true&quot; ]
then
   docker container exec -u root -i ${CONTAINER_NAME} bash -c &quot;mkdir /var/coredump &amp;&amp; chmod a+rw /var/coredump &amp;&amp; echo &apos;/var/coredump/core_%e.%p_%t&apos; &gt; /proc/sys/kernel/core_pattern&quot;
fi</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
